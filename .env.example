# Copy to .env and fill in.
ELEVENLABS_API_KEY=

# Optional: pin a voice (must support your target language). Leave empty for the agent default.
ELEVENLABS_VOICE_ID=

# Optional: reuse an existing agent instead of letting the app create one.
ELEVENLABS_AGENT_ID=

# Optional: LLM the ElevenLabs agent uses (e.g. gemini-2.5-flash, gpt-4o-mini, claude-sonnet-4-5).
ELEVENLABS_LLM=gemini-2.5-flash

# Heart sensor (optional). Source at startup: serial | fake | off.
HEART_SOURCE=serial
# Force the sensor's serial port (otherwise the first USB serial device that isn't Reachy).
# HEART_PORT=/dev/cu.usbmodem1101
# Where heart events go over OSC (TouchDesigner's OSC In default port is 10000).
HEART_OSC=127.0.0.1:10000
